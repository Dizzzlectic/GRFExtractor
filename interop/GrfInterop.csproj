<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GrfEditorSource Condition="'$(GrfEditorSource)' == ''">$(MSBuildThisFileDirectory)../scratch/grfeditor/</GrfEditorSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <ProjectReference Include="$(GrfEditorSource)GRF/GRF.csproj" />
  </ItemGroup>
</Project>
